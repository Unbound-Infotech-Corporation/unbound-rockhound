<?xml version="1.0" encoding="utf-8"?>
<!--
  Unbound Marketplace theme.
  Same charcoal + Adobe-blue palette as Unbound Rockhound so the widget sits in that shell,
  with its own keys so other Unbound Infotech apps can host it without those resources.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="UmktColorCanvas">#FF09090B</Color>
            <Color x:Key="UmktColorPanel">#FF1A1A1F</Color>
            <Color x:Key="UmktColorRaised">#FF222228</Color>
            <Color x:Key="UmktColorInput">#FF141418</Color>
            <Color x:Key="UmktColorBorder">#FF3F3F48</Color>
            <Color x:Key="UmktColorBorderSubtle">#FF222228</Color>
            <Color x:Key="UmktColorText">#FFE4E4E7</Color>
            <Color x:Key="UmktColorTextSecondary">#FFA1A1AA</Color>
            <Color x:Key="UmktColorTextTertiary">#FF71717A</Color>
            <Color x:Key="UmktColorPrimary">#FF1473E6</Color>
            <Color x:Key="UmktColorOnPrimary">#FFFAFAFA</Color>
            <Color x:Key="UmktColorSuccess">#FF22C55E</Color>
            <Color x:Key="UmktColorSuccessSubtle">#FF14532D</Color>
            <Color x:Key="UmktColorWarning">#FFEAB308</Color>

            <SolidColorBrush x:Key="UmktBrushCanvas" Color="{StaticResource UmktColorCanvas}" />
            <SolidColorBrush x:Key="UmktBrushPanel" Color="{StaticResource UmktColorPanel}" />
            <SolidColorBrush x:Key="UmktBrushRaised" Color="{StaticResource UmktColorRaised}" />
            <SolidColorBrush x:Key="UmktBrushInput" Color="{StaticResource UmktColorInput}" />
            <SolidColorBrush x:Key="UmktBrushBorder" Color="{StaticResource UmktColorBorder}" />
            <SolidColorBrush x:Key="UmktBrushBorderSubtle" Color="{StaticResource UmktColorBorderSubtle}" />
            <SolidColorBrush x:Key="UmktBrushText" Color="{StaticResource UmktColorText}" />
            <SolidColorBrush x:Key="UmktBrushTextSecondary" Color="{StaticResource UmktColorTextSecondary}" />
            <SolidColorBrush x:Key="UmktBrushTextTertiary" Color="{StaticResource UmktColorTextTertiary}" />
            <SolidColorBrush x:Key="UmktBrushPrimary" Color="{StaticResource UmktColorPrimary}" />
            <SolidColorBrush x:Key="UmktBrushOnPrimary" Color="{StaticResource UmktColorOnPrimary}" />
            <SolidColorBrush x:Key="UmktBrushSuccess" Color="{StaticResource UmktColorSuccess}" />
            <SolidColorBrush x:Key="UmktBrushSuccessSubtle" Color="{StaticResource UmktColorSuccessSubtle}" />
            <SolidColorBrush x:Key="UmktBrushWarning" Color="{StaticResource UmktColorWarning}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="UmktColorCanvas">#FFF4F4F5</Color>
            <Color x:Key="UmktColorPanel">#FFFFFFFF</Color>
            <Color x:Key="UmktColorRaised">#FFFFFFFF</Color>
            <Color x:Key="UmktColorInput">#FFFFFFFF</Color>
            <Color x:Key="UmktColorBorder">#FFD4D4D8</Color>
            <Color x:Key="UmktColorBorderSubtle">#FFE4E4E7</Color>
            <Color x:Key="UmktColorText">#FF18181B</Color>
            <Color x:Key="UmktColorTextSecondary">#FF3F3F48</Color>
            <Color x:Key="UmktColorTextTertiary">#FF71717A</Color>
            <Color x:Key="UmktColorPrimary">#FF0D66D0</Color>
            <Color x:Key="UmktColorOnPrimary">#FFFAFAFA</Color>
            <Color x:Key="UmktColorSuccess">#FF16A34A</Color>
            <Color x:Key="UmktColorSuccessSubtle">#FFDCFCE7</Color>
            <Color x:Key="UmktColorWarning">#FFCA8A04</Color>

            <SolidColorBrush x:Key="UmktBrushCanvas" Color="{StaticResource UmktColorCanvas}" />
            <SolidColorBrush x:Key="UmktBrushPanel" Color="{StaticResource UmktColorPanel}" />
            <SolidColorBrush x:Key="UmktBrushRaised" Color="{StaticResource UmktColorRaised}" />
            <SolidColorBrush x:Key="UmktBrushInput" Color="{StaticResource UmktColorInput}" />
            <SolidColorBrush x:Key="UmktBrushBorder" Color="{StaticResource UmktColorBorder}" />
            <SolidColorBrush x:Key="UmktBrushBorderSubtle" Color="{StaticResource UmktColorBorderSubtle}" />
            <SolidColorBrush x:Key="UmktBrushText" Color="{StaticResource UmktColorText}" />
            <SolidColorBrush x:Key="UmktBrushTextSecondary" Color="{StaticResource UmktColorTextSecondary}" />
            <SolidColorBrush x:Key="UmktBrushTextTertiary" Color="{StaticResource UmktColorTextTertiary}" />
            <SolidColorBrush x:Key="UmktBrushPrimary" Color="{StaticResource UmktColorPrimary}" />
            <SolidColorBrush x:Key="UmktBrushOnPrimary" Color="{StaticResource UmktColorOnPrimary}" />
            <SolidColorBrush x:Key="UmktBrushSuccess" Color="{StaticResource UmktColorSuccess}" />
            <SolidColorBrush x:Key="UmktBrushSuccessSubtle" Color="{StaticResource UmktColorSuccessSubtle}" />
            <SolidColorBrush x:Key="UmktBrushWarning" Color="{StaticResource UmktColorWarning}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="UmktTextLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushTextTertiary}" />
    </Style>

    <Style x:Key="UmktTextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushText}" />
    </Style>

    <Style x:Key="UmktTextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="UmktTextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushTextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="UmktCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource UmktBrushPanel}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmktBrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="UmktButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource UmktBrushPrimary}" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushOnPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="UmktButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource UmktBrushRaised}" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushText}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmktBrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="UmktTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Background" Value="{ThemeResource UmktBrushInput}" />
        <Setter Property="Foreground" Value="{ThemeResource UmktBrushText}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmktBrushBorder}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
</ResourceDictionary>
