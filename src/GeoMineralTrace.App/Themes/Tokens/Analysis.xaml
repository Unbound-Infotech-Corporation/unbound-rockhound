            <Color x:Key="GmtOverlaySunRay">#FF0891B2</Color>
            <Color x:Key="GmtOverlayLabelBg">#CCFFFFFF</Color>
            <Color x:Key="GmtOverlayHandle">#FF18181B</Color>

