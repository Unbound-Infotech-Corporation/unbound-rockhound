            <x:Double x:Key="GmtTimelineWaveformOpacity">0.72</x:Double>

            <Color x:Key="GmtTransportSurface">#F0FFFFFF</Color>
            <Color x:Key="GmtTransportBorder">#FFD4D4D8</Color>
            <Color x:Key="GmtTransportIcon">#FF18181B</Color>
            <Color x:Key="GmtTransportIconMuted">#FF71717A</Color>
            <Color x:Key="GmtTransportHover">#FFF4F4F5</Color>
            <Color x:Key="GmtTransportPressed">#FFE4E4E7</Color>
            <Color x:Key="GmtTransportDisabledFill">#FFF4F4F5</Color>
            <Color x:Key="GmtTransportDisabledBorder">#FFD4D4D8</Color>
            <SolidColorBrush x:Key="GmtBrushTransportSurface" Color="{StaticResource GmtTransportSurface}" />
            <SolidColorBrush x:Key="GmtBrushTransportBorder" Color="{StaticResource GmtTransportBorder}" />
            <SolidColorBrush x:Key="GmtBrushTransportIcon" Color="{StaticResource GmtTransportIcon}" />
            <SolidColorBrush x:Key="GmtBrushTransportIconMuted" Color="{StaticResource GmtTransportIconMuted}" />
            <SolidColorBrush x:Key="GmtBrushTransportHover" Color="{StaticResource GmtTransportHover}" />
