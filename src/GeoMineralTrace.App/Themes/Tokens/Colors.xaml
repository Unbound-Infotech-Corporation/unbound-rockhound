            <SolidColorBrush x:Key="GmtBrushTextDisabled" Color="{StaticResource GmtColorTextDisabled}" />
            <SolidColorBrush x:Key="GmtBrushTextEmphasis" Color="{StaticResource GmtColorTextEmphasis}" />
