            <SolidColorBrush x:Key="GmtBrushPrimary" Color="{StaticResource GmtColorPrimary}" />
            <SolidColorBrush x:Key="GmtBrushPrimaryHover" Color="{StaticResource GmtColorPrimaryHover}" />
            <SolidColorBrush x:Key="GmtBrushPrimaryPressed" Color="{StaticResource GmtColorPrimaryPressed}" />
            <SolidColorBrush x:Key="GmtBrushPrimarySubtle" Color="{StaticResource GmtColorPrimarySubtle}" />

            <SolidColorBrush x:Key="GmtBrushSuccess" Color="{StaticResource GmtSuccess}" />
            <SolidColorBrush x:Key="GmtBrushSuccessSubtle" Color="{StaticResource GmtSuccessMuted}" />
            <SolidColorBrush x:Key="GmtBrushWarning" Color="{StaticResource GmtWarning}" />
            <SolidColorBrush x:Key="GmtBrushWarningSubtle" Color="{StaticResource GmtWarningMuted}" />
            <SolidColorBrush x:Key="GmtBrushError" Color="{StaticResource GmtError}" />
