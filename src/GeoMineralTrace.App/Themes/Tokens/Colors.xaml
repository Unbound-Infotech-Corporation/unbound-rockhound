<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoMineral Trace — Color tokens (Light / Dark ThemeDictionaries)

  Palette philosophy: cool charcoal surfaces + Adobe-blue primary (creative-suite chrome)
  + amber/cyan accents for solar/geo measurement overlays.

  Gray scale (9+ steps):
    950 Canvas · 900 Base · 850 Sidebar · 800 Panel · 750 Raised · 700 Hover
    600 BorderStrong · 500 Border · 400 Tertiary · 300 Secondary · 100 Primary · 50 Emphasis

  WCAG AA: primary text on surfaces ≥ 4.5:1; large text / UI chrome ≥ 3:1.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

