<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoMineral Trace — Elevation tokens

  Dark mode: surface layering (lighter = higher elevation). Shadows read poorly on dark UI.
  Light mode: hairline border + soft layered shadow.

  Levels: 0 Canvas · 1 Base · 2 Panel · 3 Raised · 4 Overlay · 5 Popover
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Surface brushes per elevation level -->
            <SolidColorBrush x:Key="GmtElevation0Brush" Color="#FF09090B" />
            <SolidColorBrush x:Key="GmtElevation1Brush" Color="#FF0F0F12" />
            <SolidColorBrush x:Key="GmtElevation2Brush" Color="#FF1A1A1F" />
            <SolidColorBrush x:Key="GmtElevation3Brush" Color="#FF222228" />
            <SolidColorBrush x:Key="GmtElevation4Brush" Color="#FF2A2A32" />
            <SolidColorBrush x:Key="GmtElevation5Brush" Color="#FF32323C" />

            <!-- Shadow tints (subtle, for floating elements only) -->
            <Color x:Key="GmtShadowColor">#66000000</Color>
            <x:Double x:Key="GmtShadowOpacitySm">0.24</x:Double>
            <x:Double x:Key="GmtShadowOpacityMd">0.32</x:Double>
            <x:Double x:Key="GmtShadowOpacityLg">0.40</x:Double>
            <x:Double x:Key="GmtShadowBlurSm">8</x:Double>
            <x:Double x:Key="GmtShadowBlurMd">16</x:Double>
            <x:Double x:Key="GmtShadowBlurLg">24</x:Double>
            <x:Double x:Key="GmtShadowOffsetY">2</x:Double>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GmtElevation0Brush" Color="#FFF4F4F5" />
            <SolidColorBrush x:Key="GmtElevation1Brush" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="GmtElevation2Brush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GmtElevation3Brush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GmtElevation4Brush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GmtElevation5Brush" Color="#FFFFFFFF" />

            <Color x:Key="GmtShadowColor">#1A09090B</Color>
            <x:Double x:Key="GmtShadowOpacitySm">0.06</x:Double>
            <x:Double x:Key="GmtShadowOpacityMd">0.10</x:Double>
            <x:Double x:Key="GmtShadowOpacityLg">0.14</x:Double>
            <x:Double x:Key="GmtShadowBlurSm">4</x:Double>
            <x:Double x:Key="GmtShadowBlurMd">12</x:Double>
            <x:Double x:Key="GmtShadowBlurLg">20</x:Double>
            <x:Double x:Key="GmtShadowOffsetY">1</x:Double>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared border treatment for elevated cards (both themes) -->
    <Thickness x:Key="GmtCardBorderThickness">1</Thickness>

</ResourceDictionary>
