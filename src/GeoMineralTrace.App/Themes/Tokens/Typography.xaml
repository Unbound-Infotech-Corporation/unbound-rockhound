<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoMineral Trace — Typography system
  UI: Bahnschrift (geometric, Adobe-like tool chrome on Windows)
  Display: Bahnschrift SemiBold
  Mono: Cascadia Mono for coordinates, confidence %, logs
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font families -->
    <FontFamily x:Key="GmtFontUi">Bahnschrift</FontFamily>
    <FontFamily x:Key="GmtFontUiDisplay">Bahnschrift SemiBold</FontFamily>
    <FontFamily x:Key="GmtFontMono">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Type scale (px) -->
    <x:Double x:Key="GmtFontSizeCaption">12</x:Double>
    <x:Double x:Key="GmtFontSizeBodySm">13</x:Double>
    <x:Double x:Key="GmtFontSizeBody">14</x:Double>
    <x:Double x:Key="GmtFontSizeSubtitle">16</x:Double>
    <x:Double x:Key="GmtFontSizeHeadline">20</x:Double>
    <x:Double x:Key="GmtFontSizeTitle">24</x:Double>
    <x:Double x:Key="GmtFontSizeDisplay">32</x:Double>

    <!-- Line heights (px) -->
    <x:Double x:Key="GmtLineHeightCaption">16</x:Double>
    <x:Double x:Key="GmtLineHeightBodySm">18</x:Double>
    <x:Double x:Key="GmtLineHeightBody">20</x:Double>
    <x:Double x:Key="GmtLineHeightSubtitle">24</x:Double>
    <x:Double x:Key="GmtLineHeightHeadline">28</x:Double>
    <x:Double x:Key="GmtLineHeightTitle">32</x:Double>
    <x:Double x:Key="GmtLineHeightDisplay">40</x:Double>

    <!-- Font weights -->
    <FontWeight x:Key="GmtWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="GmtWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="GmtWeightSemibold">SemiBold</FontWeight>
    <FontWeight x:Key="GmtWeightBold">Bold</FontWeight>

    <!-- ── Text styles ─────────────────────────────────────────────── -->

    <Style x:Key="GmtTextDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUiDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeDisplay}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightDisplay}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightSemibold}" />
        <Setter Property="CharacterSpacing" Value="-40" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
    </Style>

    <Style x:Key="GmtTextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUiDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightSemibold}" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
    </Style>

    <Style x:Key="GmtTextHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeHeadline}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightHeadline}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightSemibold}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
    </Style>

    <Style x:Key="GmtTextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeSubtitle}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightSubtitle}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightMedium}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
    </Style>

    <Style x:Key="GmtTextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightBody}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightRegular}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextSecondary}" />
    </Style>

    <Style x:Key="GmtTextBodySm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBodySm}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightBodySm}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextSecondary}" />
    </Style>

    <Style x:Key="GmtTextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextTertiary}" />
    </Style>

    <Style x:Key="GmtTextLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightMedium}" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextTertiary}" />
    </Style>

    <!-- Technical readouts — layer-properties panel style -->
    <Style x:Key="GmtTextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBodySm}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightBodySm}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextData}" />
    </Style>

    <Style x:Key="GmtTextMonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightBody}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightMedium}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
    </Style>

    <!-- Timecodes / NLE position readouts — tabular monospace -->
    <Style x:Key="GmtTextTimecode" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource GmtLineHeightCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightMedium}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextData}" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="GmtTextTimecodeEmphasis" TargetType="TextBlock" BasedOn="{StaticResource GmtTextTimecode}">
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBodySm}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightSemibold}" />
    </Style>

</ResourceDictionary>
