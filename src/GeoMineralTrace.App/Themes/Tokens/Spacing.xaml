<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoMineral Trace — Spacing tokens (4px base unit)
  Usage:
    - GmtSpace* (x:Double): StackPanel.Spacing, Grid.*Spacing, Width/Height
    - Thickness keys (GmtPagePadding, GmtPanelPadding, …): Margin / Padding only
  Do NOT bind Margin/Padding to GmtSpace* doubles — WinUI throws (app crash).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="GmtSpace0">0</x:Double>
    <x:Double x:Key="GmtSpace1">4</x:Double>
    <x:Double x:Key="GmtSpace2">8</x:Double>
    <x:Double x:Key="GmtSpace3">12</x:Double>
    <x:Double x:Key="GmtSpace4">16</x:Double>
    <x:Double x:Key="GmtSpace5">20</x:Double>
    <x:Double x:Key="GmtSpace6">24</x:Double>
    <x:Double x:Key="GmtSpace8">32</x:Double>
    <x:Double x:Key="GmtSpace10">40</x:Double>
    <x:Double x:Key="GmtSpace12">48</x:Double>
    <x:Double x:Key="GmtSpace16">64</x:Double>
    <x:Double x:Key="GmtSpace20">80</x:Double>

    <!-- Semantic layout aliases -->
    <Thickness x:Key="GmtPagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="GmtPagePaddingWide">32,20,32,32</Thickness>
    <Thickness x:Key="GmtPanelPadding">16</Thickness>
    <Thickness x:Key="GmtPanelPaddingCompact">12</Thickness>
    <Thickness x:Key="GmtInsetHorizontal">16,0</Thickness>
    <x:Double x:Key="GmtStackGapTight">8</x:Double>
    <x:Double x:Key="GmtStackGapDefault">12</x:Double>
    <x:Double x:Key="GmtStackGapRelaxed">16</x:Double>
    <x:Double x:Key="GmtStackGapSection">24</x:Double>
    <x:Double x:Key="GmtGridGap">12</x:Double>
    <x:Double x:Key="GmtToolbarGap">8</x:Double>

    <!-- Navigation / chrome -->
    <x:Double x:Key="GmtNavWidthExpanded">248</x:Double>
    <x:Double x:Key="GmtNavWidthCompact">56</x:Double>
    <x:Double x:Key="GmtTitleBarHeight">48</x:Double>
    <x:Double x:Key="GmtInspectorWidth">300</x:Double>
    <x:Double x:Key="GmtTimelineHeight">72</x:Double>
    <x:Double x:Key="GmtPreviewMinHeight">280</x:Double>

</ResourceDictionary>
