<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoMineral Trace — Button system
  High-DPI hairlines (UseLayoutRounding), animated hover/press (scale + overlay),
  Adobe-like dense chrome with clear primary / secondary / ghost / destructive roles.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared interactive template: crisp edges + motion -->
    <ControlTemplate x:Key="GmtButtonTemplate" TargetType="Button">
        <Grid
            x:Name="RootGrid"
            Background="Transparent"
            UseLayoutRounding="True"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="RootTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource GmtDurationFast}">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition To="Pressed" GeneratedDuration="{StaticResource GmtDurationInstant}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation
                                Storyboard.TargetName="PressOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="{StaticResource GmtDurationFast}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="{StaticResource GmtDurationFast}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="PressOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="1.015"
                                Duration="{StaticResource GmtDurationFast}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="1.015"
                                Duration="{StaticResource GmtDurationFast}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0.35"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="PressOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.97"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.97"
                                Duration="{StaticResource GmtDurationInstant}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Chrome"
                                Storyboard.TargetProperty="Opacity"
                                To="0.45"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="HoverOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="PressOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootTransform"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="{StaticResource GmtDurationInstant}" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border
                x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
                <Grid>
                    <Border
                        x:Name="HoverOverlay"
                        Background="{ThemeResource GmtBrushBackgroundHover}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                    <Border
                        x:Name="PressOverlay"
                        Background="{ThemeResource GmtBrushPrimarySubtle}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Primary: solid accent, brighter hover overlay -->
    <ControlTemplate x:Key="GmtButtonPrimaryTemplate" TargetType="Button">
        <Grid
            x:Name="RootGrid"
            Background="Transparent"
            UseLayoutRounding="True"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="RootTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource GmtDurationFast}">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition To="Pressed" GeneratedDuration="{StaticResource GmtDurationInstant}" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource GmtDurationFast}" />
                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationFast}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource GmtDurationFast}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource GmtDurationFast}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource GmtDurationFast}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0.55" Duration="{StaticResource GmtDurationFast}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.25" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.965" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.965" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0.25" Duration="{StaticResource GmtDurationInstant}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.42" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource GmtDurationInstant}" />
                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationInstant}" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Soft outer glow for primary CTAs on high-DPI displays -->
            <Border
                x:Name="FocusRing"
                Margin="-2"
                Background="Transparent"
                BorderBrush="{ThemeResource GmtBrushPrimaryHover}"
                BorderThickness="1.5"
                CornerRadius="6"
                Opacity="0"
                IsHitTestVisible="False" />

            <Border
                x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
                <Grid>
                    <Border
                        x:Name="HoverOverlay"
                        Background="{ThemeResource GmtBrushPrimaryHover}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                    <Border
                        x:Name="PressOverlay"
                        Background="{ThemeResource GmtBrushPrimaryPressed}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GmtButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBodySm}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightSemibold}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusButton}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource GmtButtonTemplate}" />
    </Style>

    <Style x:Key="GmtButtonPrimary" TargetType="Button" BasedOn="{StaticResource GmtButtonBase}">
        <Setter Property="Background" Value="{ThemeResource GmtBrushPrimary}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextEmphasis}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushPrimary}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Template" Value="{StaticResource GmtButtonPrimaryTemplate}" />
    </Style>

    <Style x:Key="GmtButtonSecondary" TargetType="Button" BasedOn="{StaticResource GmtButtonBase}">
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundRaised}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderDefault}" />
    </Style>

    <Style x:Key="GmtButtonGhost" TargetType="Button" BasedOn="{StaticResource GmtButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="GmtButtonDestructive" TargetType="Button" BasedOn="{StaticResource GmtButtonBase}">
        <Setter Property="Background" Value="{ThemeResource GmtBrushErrorSubtle}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushError}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushError}" />
    </Style>

    <!-- Compact list-row / dense toolbar actions -->
    <Style x:Key="GmtButtonCompact" TargetType="Button" BasedOn="{StaticResource GmtButtonSecondary}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeCaption}" />
    </Style>

    <Style x:Key="GmtToolbarButton" TargetType="Button" BasedOn="{StaticResource GmtButtonSecondary}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBodySm}" />
        <Setter Property="FontWeight" Value="{StaticResource GmtWeightMedium}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusSm}" />
    </Style>

    <Style x:Key="GmtAccentButton" TargetType="Button" BasedOn="{StaticResource GmtButtonPrimary}" />

</ResourceDictionary>
