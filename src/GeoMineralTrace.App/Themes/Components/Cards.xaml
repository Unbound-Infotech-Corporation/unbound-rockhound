<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GmtCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundPanel}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="{StaticResource GmtCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource GmtPanelPadding}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="GmtPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtElevation2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusPanel}" />
        <Setter Property="Padding" Value="{StaticResource GmtPanelPaddingCompact}" />
    </Style>

    <Style x:Key="GmtInspectorPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundSidebar}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="{StaticResource GmtPanelPadding}" />
    </Style>

    <Style x:Key="GmtPreviewViewport" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtBrushPreviewLetterbox}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource GmtCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusCard}" />
    </Style>

    <Style x:Key="GmtDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

</ResourceDictionary>
