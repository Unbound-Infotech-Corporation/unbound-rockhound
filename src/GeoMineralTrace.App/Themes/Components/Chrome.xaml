<?xml version="1.0" encoding="utf-8"?>
<!--
  GeoMineral Trace — App chrome (toolbars, status strips, page headers)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary action / filter toolbar — elevated panel with accent rail -->
    <Style x:Key="GmtToolbarStrip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtElevation3Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusPanel}" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Secondary toolbar row (rating, pagination, batch actions) -->
    <Style x:Key="GmtToolbarStripSubtle" TargetType="Border" BasedOn="{StaticResource GmtToolbarStrip}">
        <Setter Property="Background" Value="{ThemeResource GmtElevation2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- Bottom status / progress strip -->
    <Style x:Key="GmtStatusStrip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundSidebar}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusPanel}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Horizontal cluster for toolbar buttons and inputs -->
    <Style x:Key="GmtCommandRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource GmtToolbarGap}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Page title block (title + subtitle) -->
    <Style x:Key="GmtPageHeader" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Version / badge pill in app chrome -->
    <Style x:Key="GmtBadgePill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundRaised}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusSm}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
