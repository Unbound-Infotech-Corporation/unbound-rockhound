<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GmtTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusInput}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundInput}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource GmtBrushTextTertiary}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource GmtBrushPrimarySubtle}" />
    </Style>

    <Style x:Key="GmtComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusInput}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundInput}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="GmtNumberBox" TargetType="NumberBox">
        <Setter Property="FontFamily" Value="{StaticResource GmtFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource GmtFontSizeBodySm}" />
        <Setter Property="CornerRadius" Value="{StaticResource GmtRadiusInput}" />
        <Setter Property="Background" Value="{ThemeResource GmtBrushBackgroundInput}" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GmtBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="GmtProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{ThemeResource GmtBrushPrimary}" />
        <Setter Property="Background" Value="{ThemeResource GmtBrushBorderSubtle}" />
    </Style>

</ResourceDictionary>
