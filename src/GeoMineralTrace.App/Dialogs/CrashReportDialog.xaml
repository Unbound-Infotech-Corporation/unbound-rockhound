<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="GeoMineralTrace_App.Dialogs.CrashReportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Something went wrong"
    PrimaryButtonText="Copy report"
    SecondaryButtonText="Save report file…"
    CloseButtonText="Dismiss"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="480" MaxWidth="560">
        <TextBlock Style="{StaticResource GmtTextBody}" TextWrapping="Wrap"
            Text="Unbound Rockhound saved a diagnostic report locally. You can copy it, save a file to email, or open your mail app with a pre-filled message." />

        <TextBlock x:Name="SummaryText" Style="{StaticResource GmtTextBodySm}" TextWrapping="Wrap" />

        <TextBox x:Name="UserNotesBox" Style="{StaticResource GmtTextBox}"
            Header="What were you doing? (optional)"
            PlaceholderText="e.g. Importing BLM claims, analyzing a YouTube video…"
            AcceptsReturn="True" TextWrapping="Wrap" Height="80" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save zip bundle…" Click="SaveZip_Click" Style="{StaticResource GmtButtonSecondary}" />
            <Button Content="Send email…" Click="SendEmail_Click" Style="{StaticResource GmtButtonSecondary}" />
            <Button Content="Open reports folder" Click="OpenFolder_Click" Style="{StaticResource GmtButtonGhost}" />
        </StackPanel>

        <TextBlock Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap"
            Text="Reports stay on your PC until you choose to share them. No data is sent automatically." />
    </StackPanel>
</ContentDialog>
