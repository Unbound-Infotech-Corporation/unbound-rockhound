<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="GeoMineralTrace_App.Dialogs.InstagramSignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Sign in to Instagram"
    PrimaryButtonText="Save session"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <Grid Width="720" Height="520" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap"
            Text="Sign in with an Instagram account that can view the posts you want to analyze. Session cookies stay on this PC for yt-dlp. Sign out anytime in Settings." />

        <Border Grid.Row="1" BorderBrush="{ThemeResource GmtBrushBorderDefault}" BorderThickness="1"
            CornerRadius="{StaticResource GmtRadiusSm}" Background="{ThemeResource GmtBrushBackgroundPanel}">
            <muxc:WebView2 x:Name="AuthWebView" />
        </Border>

        <TextBlock x:Name="StatusLabel" Grid.Row="2" Style="{StaticResource GmtTextMono}" Text="Loading sign-in…" />
    </Grid>
</ContentDialog>
