<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.GlossaryCreditsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource GmtTextTitle}" Text="Glossary image credits" />
            <TextBlock Style="{StaticResource GmtTextBody}"
                Text="Attributions for Wikimedia Commons images used in the mineral glossary (CC0 / CC-BY / CC-BY-SA / Public Domain)." />
            <Button Content="Back to Glossary" Click="Back_Click" Style="{StaticResource GmtButtonGhost}" HorizontalAlignment="Left" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GmtCard}">
            <ListView x:Name="CreditsList" Style="{StaticResource GmtListView}" ItemContainerStyle="{StaticResource GmtListViewItem}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,8" Spacing="2">
                            <TextBlock Style="{StaticResource GmtTextBody}" FontWeight="SemiBold" Text="{Binding SpeciesId}" />
                            <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding LicenseType}" />
                            <TextBlock Style="{StaticResource GmtTextBodySm}" Text="{Binding AttributionText}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="{Binding SourceUrl}" NavigateUri="{Binding SourceUri}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
