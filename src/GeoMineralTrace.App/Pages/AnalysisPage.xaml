<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeoMineralTrace_App.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GmtToolbarStrip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource GmtPageHeader}">
                    <TextBlock Style="{StaticResource GmtTextTitle}" Text="Video Analysis" />
                    <TextBlock Style="{StaticResource GmtTextBody}" TextWrapping="Wrap"
                        Text="Ingest media, run the forensic pipeline, and export auditable research artifacts." />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource GmtCommandRow}">
                    <Button Content="Load session…" Click="LoadSession_Click" Style="{StaticResource GmtToolbarButton}"
                        ToolTipService.ToolTip="Open a previously saved analysis session from disk" />
                    <Button Content="Clear" Click="Clear_Click" Style="{StaticResource GmtToolbarButton}"
                        ToolTipService.ToolTip="Clear the media queue, preview, and in-memory session results" />
                    <Button x:Name="DeepAnalysisButton" Content="Deep Analysis" Click="DeepAnalysis_Click"
                        Style="{StaticResource GmtButtonSecondary}" IsEnabled="False"
                        ToolTipService.ToolTip="Score Evidence Board items, select corroborating clusters, and generate ranked hypotheses (runs after initial analysis)" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Style="{StaticResource GmtButtonSecondary}" IsEnabled="False"
                        ToolTipService.ToolTip="No analysis is running" />
                    <Button x:Name="RunButton" Content="Run analysis" Click="Run_Click" Style="{StaticResource GmtButtonPrimary}"
                        ToolTipService.ToolTip="Run the analysis pipeline on the queued media (or the URL in the box)" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource GmtGridGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GmtCard}">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="INGEST" />
                    <Button Content="Add local files…" Click="AddFiles_Click" Style="{StaticResource GmtButtonSecondary}" HorizontalAlignment="Stretch" />
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="YOUTUBE / INSTAGRAM" Margin="0,4,0,0" />
                    <TextBox x:Name="YouTubeUrlBox" Style="{StaticResource GmtTextBox}"
                        PlaceholderText="Paste YouTube URL — clip capture opens automatically"
                        KeyDown="YouTubeUrlBox_KeyDown" TextChanged="YouTubeUrlBox_TextChanged"
                        LostFocus="YouTubeUrlBox_LostFocus" />
                    <TextBlock Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap"
                        Text="YouTube uses OBS-style screen capture (not yt-dlp). Set In/Out, then Record &amp; analyze selection." />
                    <Button Content="Full video download (yt-dlp)…" Click="DownloadAndAnalyze_Click"
                        Style="{StaticResource GmtButtonSecondary}" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
                        <Button Content="Preview Instagram" Click="PreviewYouTube_Click" Style="{StaticResource GmtButtonGhost}" />
                    </StackPanel>
                    <Button x:Name="YouTubeSignInButton" Content="Sign in to YouTube…" Click="YouTubeSignIn_Click"
                        Style="{StaticResource GmtButtonGhost}" HorizontalAlignment="Stretch" />
                    <Button x:Name="InstagramSignInButton" Content="Sign in to Instagram…" Click="InstagramSignIn_Click"
                        Style="{StaticResource GmtButtonGhost}" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="YouTubeAuthCaption" Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap"
                        Text="YouTube: public videos work without sign-in. Instagram: most posts need sign-in. Cookies stay local." />
                    <Border Style="{StaticResource GmtDivider}" />
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="QUEUE" />
                    <ListView x:Name="FileList" Style="{StaticResource GmtListView}" MaxHeight="200"
                        SelectionChanged="FileList_SelectionChanged" ItemContainerStyle="{StaticResource GmtListViewItem}" />
                    <controls:EmptyState x:Name="QueueEmpty" Icon="&#xE8B7;" Title="No media queued"
                        Description="Add local video/image files or a YouTube / Instagram URL to begin analysis." Visibility="Visible" />
                </StackPanel>
            </Border>

            <!-- Player viewport -->
            <Border Grid.Column="1" Style="{StaticResource GmtPreviewViewport}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Media surface -->
                    <Grid>
                        <controls:YouTubeClipWorkbench x:Name="YouTubeClipPanel" Visibility="Collapsed" />
                        <muxc:WebView2 x:Name="YouTubePreview" Visibility="Collapsed" />
                        <MediaPlayerElement
                            x:Name="PreviewPlayer"
                            AreTransportControlsEnabled="False"
                            Visibility="Collapsed"
                            Stretch="Uniform" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />

                        <!-- Idle / processing placeholder -->
                        <StackPanel
                            x:Name="PreviewPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource GmtSpace3}"
                            MaxWidth="420"
                            Padding="{StaticResource GmtPanelPadding}">
                            <FontIcon
                                Glyph="&#xE714;"
                                FontSize="36"
                                Foreground="{ThemeResource GmtBrushTextTertiary}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                x:Name="PreviewStatusText"
                                Style="{StaticResource GmtTextBody}"
                                Text="Preview — select media or run analysis"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                x:Name="ProgressBar"
                                Style="{StaticResource GmtProgressBar}"
                                Width="280"
                                Minimum="0"
                                Maximum="1" />
                            <TextBlock
                                x:Name="StatusText"
                                Style="{StaticResource GmtTextMono}"
                                Text="Idle"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="ActiveStageCaption"
                                Style="{StaticResource GmtTextCaption}"
                                Text=""
                                TextAlignment="Center"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="ToolStatusText"
                                Style="{StaticResource GmtTextCaption}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="360" />
                        </StackPanel>
                    </Grid>

                    <!-- Transport + timecode / confidence chrome -->
                    <Border Grid.Row="1" Style="{StaticResource GmtTransportStrip}">
                        <Grid ColumnSpacing="{StaticResource GmtSpace3}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GmtSpace1}" VerticalAlignment="Center">
                                <Button
                                    x:Name="TransportRewindButton"
                                    Style="{StaticResource GmtTransportButton}"
                                    Click="TransportRewind_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Load a local video in the preview to use transport controls">
                                    <FontIcon Glyph="&#xE100;" FontSize="14" />
                                </Button>
                                <Button
                                    x:Name="TransportPlayPauseButton"
                                    Style="{StaticResource GmtTransportButtonPrimary}"
                                    Click="TransportPlayPause_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Load a local video in the preview to use transport controls">
                                    <FontIcon x:Name="TransportPlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <Button
                                    x:Name="TransportForwardButton"
                                    Style="{StaticResource GmtTransportButton}"
                                    Click="TransportForward_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Load a local video in the preview to use transport controls">
                                    <FontIcon Glyph="&#xE101;" FontSize="14" />
                                </Button>
                                <Button
                                    x:Name="TransportFrameBackButton"
                                    Style="{StaticResource GmtTransportButton}"
                                    Click="TransportFrameBack_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Load a local video in the preview to use transport controls">
                                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                                </Button>
                                <Button
                                    x:Name="TransportFrameForwardButton"
                                    Style="{StaticResource GmtTransportButton}"
                                    Click="TransportFrameForward_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Load a local video in the preview to use transport controls">
                                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                                </Button>
                                <TextBlock
                                    x:Name="TransportAvailabilityCaption"
                                    Style="{StaticResource GmtTextCaption}"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Text="No local preview"
                                    Opacity="0.75" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GmtSpace2}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TimecodePositionText" Style="{StaticResource GmtTextTimecodeEmphasis}" Text="00:00:00.000" MinWidth="96" />
                                <TextBlock Style="{StaticResource GmtTextCaption}" Text="/" VerticalAlignment="Center" />
                                <TextBlock x:Name="TimecodeDurationText" Style="{StaticResource GmtTextTimecode}" Text="00:00:00.000" MinWidth="96" TextAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource GmtSpace2}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource GmtTextLabel}" Text="CONF" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="PlayerConfidenceText"
                                    Style="{StaticResource GmtTextTimecode}"
                                    Text="--"
                                    MinWidth="44"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Keyframe filmstrip -->
                    <Border Grid.Row="2" Style="{StaticResource GmtKeyframeStripHost}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="KeyframeStrip" Orientation="Horizontal" Spacing="{StaticResource GmtSpace2}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GmtInspectorPanel}">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="STATUS" />
                    <controls:AnalysisStagePanel x:Name="StagePanel" />
                    <muxc:InfoBar
                        x:Name="AnalysisErrorBar"
                        Style="{StaticResource GmtInfoBar}"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Error"
                        Title="Analysis error"
                        Message="" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Timeline / waveform / log -->
        <Border Grid.Row="2" Style="{StaticResource GmtStatusStrip}" Padding="{StaticResource GmtPanelPaddingCompact}">
            <Grid RowSpacing="{StaticResource GmtSpace2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="TIMELINE" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TimelineFractionText"
                        Grid.Column="1"
                        Style="{StaticResource GmtTextTimecode}"
                        Text="0%"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Decorative waveform + scrubber stack -->
                <Grid Grid.Row="1" Height="56">
                    <Border Style="{StaticResource GmtWaveformHost}" VerticalAlignment="Stretch">
                        <Canvas
                            x:Name="WaveformCanvas"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="WaveformCanvas_SizeChanged" />
                    </Border>

                    <!-- Selection / progress highlight band (analysis progress or scrub fill) -->
                    <Border
                        x:Name="TimelineSelectionBand"
                        Style="{StaticResource GmtTimelineSelectionBand}"
                        HorizontalAlignment="Left"
                        Width="0"
                        VerticalAlignment="Stretch"
                        Opacity="0.85"
                        IsHitTestVisible="False" />

                    <Border
                        x:Name="TimelineScrubberHost"
                        Style="{StaticResource GmtScrubberTrack}"
                        VerticalAlignment="Bottom"
                        SizeChanged="TimelineTrack_SizeChanged"
                        PointerPressed="TimelineTrack_PointerPressed"
                        PointerMoved="TimelineTrack_PointerMoved"
                        PointerReleased="TimelineTrack_PointerReleased"
                        PointerCanceled="TimelineTrack_PointerReleased"
                        ToolTipService.ToolTip="Load a local video to scrub the playhead">
                        <Grid x:Name="TimelineTrack">
                            <Rectangle
                                x:Name="TimelineFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                Fill="{ThemeResource GmtBrushTimelineProgress}"
                                RadiusX="2"
                                RadiusY="2" />
                            <Rectangle
                                x:Name="TimelinePlayheadGlow"
                                Width="6"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource GmtBrushTimelinePlayheadGlow}"
                                IsHitTestVisible="False" />
                            <Rectangle
                                x:Name="TimelinePlayhead"
                                Width="2"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource GmtBrushTimelinePlayhead}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource GmtDivider}" Margin="0" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Style="{StaticResource GmtTextMono}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
