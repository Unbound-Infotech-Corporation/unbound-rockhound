<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.CasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeoMineralTrace_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource GmtTextTitle}" Text="Analysis Cases" />
            <TextBlock Style="{StaticResource GmtTextBody}" TextWrapping="Wrap"
                Text="Every video analysis is a separate record. Open a case to load its evidence, hypotheses, and map — isolated from other runs." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource GmtButtonSecondary}" />
            <Button Content="Open selected" Click="Open_Click" Style="{StaticResource GmtButtonPrimary}" />
            <Button Content="Delete selected" Click="Delete_Click" Style="{StaticResource GmtButtonDestructive}" />
            <Button Content="Analyze new media" Click="Analyze_Click" Style="{StaticResource GmtButtonGhost}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource GmtCard}">
            <Grid>
                <ListView x:Name="CaseList" Style="{StaticResource GmtListView}"
                    SelectionMode="Single" DoubleTapped="CaseList_DoubleTapped"
                    ItemContainerStyle="{StaticResource GmtListViewItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource GmtTextBody}" FontWeight="SemiBold"
                                        Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource GmtTextMono}" Text="{Binding ProgressLine}" Opacity="0.85" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource GmtTextMono}" Text="{Binding StatusLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding CountsLabel}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <controls:EmptyState x:Name="CaseEmpty" Icon="&#xE8F1;" Title="No analysis cases yet"
                    Description="Run Analyze on a local file or YouTube URL. Each completed run appears here as its own record." />
            </Grid>
        </Border>
    </Grid>
</Page>
