<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.GlossaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" ColumnSpacing="{StaticResource GmtGridGap}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource GmtTextTitle}" Text="Mineral &amp; Gem Glossary" />
                    <TextBlock Style="{StaticResource GmtTextBody}"
                        Text="Offline species facts generated from structured open data. Images (when present) are CC0 / CC-BY / CC-BY-SA / Public Domain only." />
                </StackPanel>
                <Button Grid.Column="1" Content="Image credits" Click="Credits_Click"
                    Style="{StaticResource GmtButtonGhost}" VerticalAlignment="Top" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource GmtToolbarStrip}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
                <TextBox x:Name="SearchBox" Style="{StaticResource GmtTextBox}" Width="200"
                    PlaceholderText="Name / formula…" TextChanged="Filter_Changed" />
                <ComboBox x:Name="CrystalBox" Style="{StaticResource GmtComboBox}" Width="180"
                    PlaceholderText="Crystal system" SelectionChanged="Filter_Changed" />
                <NumberBox x:Name="MohsMinBox" Style="{StaticResource GmtNumberBox}" Header="Mohs ≥"
                    Minimum="0" Maximum="10" Width="100" ValueChanged="Mohs_Changed" />
                <NumberBox x:Name="MohsMaxBox" Style="{StaticResource GmtNumberBox}" Header="Mohs ≤"
                    Minimum="0" Maximum="10" Width="100" ValueChanged="Mohs_Changed" />
                <TextBox x:Name="ColorBox" Style="{StaticResource GmtTextBox}" Width="120"
                    PlaceholderText="Color…" TextChanged="Filter_Changed" />
                <ComboBox x:Name="StateBox" Style="{StaticResource GmtFilterComboBox}"
                    PlaceholderText="All states" SelectionChanged="Filter_Changed"
                    ToolTipService.ToolTip="Filter to species reported in localities for this state" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GmtCard}">
            <ListView x:Name="SpeciesList" Style="{StaticResource GmtListView}" SelectionMode="Single"
                SelectionChanged="SpeciesList_SelectionChanged" ItemContainerStyle="{StaticResource GmtListViewItem}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,6" Spacing="2">
                            <TextBlock Style="{StaticResource GmtTextBody}" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource GmtPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="12" Padding="4">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource GmtTextTitle}" Text="Select a species" />
                    <TextBlock x:Name="DetailAliases" Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource GmtCard}" Padding="12">
                        <ItemsControl x:Name="PropertyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource GmtTextLabel}" Text="{Binding Key}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource GmtTextBody}" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="DESCRIPTION" />
                    <TextBlock x:Name="DetailDescription" Style="{StaticResource GmtTextBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="IMAGES" />
                    <TextBlock x:Name="NoImageText" Style="{StaticResource GmtTextBody}" Text="No image available yet"
                        Visibility="Collapsed" Opacity="0.75" />
                    <ItemsControl x:Name="ImageGallery">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12" Spacing="4">
                                    <Image Source="{Binding Bitmap}" MaxHeight="280" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding Attribution}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="LocalitiesButton" Content="Known localities" Click="Localities_Click"
                        Style="{StaticResource GmtButtonSecondary}" HorizontalAlignment="Left" IsEnabled="False" />
                    <ListView x:Name="LocalityHits" Style="{StaticResource GmtListView}" MaxHeight="200"
                        Visibility="Collapsed" ItemContainerStyle="{StaticResource GmtListViewItem}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
