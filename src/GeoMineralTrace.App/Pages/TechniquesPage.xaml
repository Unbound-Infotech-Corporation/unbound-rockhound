<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.TechniquesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" ColumnSpacing="{StaticResource GmtGridGap}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Style="{StaticResource GmtTextTitle}" Text="Techniques &amp; Knowledge Base" />
            <TextBlock Style="{StaticResource GmtTextBody}" Text="Offline reference for solar geolocation, SPA, and forensic methods." />
        </StackPanel>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Style="{StaticResource GmtTextBox}"
            PlaceholderText="Search methods, SPA, ShadowFinder…"
            TextChanged="SearchBox_TextChanged" />

        <Border Grid.Row="2" Style="{StaticResource GmtCard}">
            <ListView x:Name="ArticleList" Style="{StaticResource GmtListView}" SelectionChanged="ArticleList_SelectionChanged" ItemContainerStyle="{StaticResource GmtListViewItem}" />
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource GmtPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyBlock" Style="{StaticResource GmtTextMono}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
