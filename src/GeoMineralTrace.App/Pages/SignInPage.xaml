<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource GmtPagePaddingWide}">
        <StackPanel Spacing="{StaticResource GmtStackGapSection}" MaxWidth="480">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource GmtTextTitle}" Text="Cloud account" />
                <TextBlock Style="{StaticResource GmtTextBody}" TextWrapping="Wrap"
                    Text="Sign in with email to sync your Unbound Rockhound profile across desktop and Android. Cases and trips stay local." />
            </StackPanel>

            <Border Style="{StaticResource GmtCard}">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="SUPABASE PROJECT" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource GmtTextBox}" Header="Project URL"
                        PlaceholderText="https://xxxx.supabase.co" />
                    <PasswordBox x:Name="AnonKeyBox" Header="Anon key" />
                    <Button Content="Save project settings" Click="SaveConfig_Click" Style="{StaticResource GmtButtonSecondary}" />
                    <TextBlock x:Name="ConfigStatus" Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GmtCard}">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="EMAIL / PASSWORD" />
                    <ToggleSwitch x:Name="ModeToggle" Header="Create new account" OffContent="Sign in" OnContent="Sign up"
                        Toggled="ModeToggle_Toggled" />
                    <TextBox x:Name="EmailBox" Style="{StaticResource GmtTextBox}" Header="Email"
                        PlaceholderText="you@example.com" InputScope="EmailSmtpAddress" />
                    <PasswordBox x:Name="PasswordBox" Header="Password" />
                    <TextBox x:Name="DisplayNameBox" Style="{StaticResource GmtTextBox}" Header="Display name (sign up)"
                        PlaceholderText="Field name" Visibility="Collapsed" />
                    <Button x:Name="SubmitButton" Content="Sign in" Click="Submit_Click" Style="{StaticResource GmtButtonPrimary}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
