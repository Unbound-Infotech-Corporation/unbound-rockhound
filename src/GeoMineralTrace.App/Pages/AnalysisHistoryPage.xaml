<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.AnalysisHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeoMineralTrace_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource GmtTextTitle}" Text="Analysis History" />
            <TextBlock Style="{StaticResource GmtTextBody}" TextWrapping="Wrap"
                Text="Completed video analyses, most recent first. Removing an entry hides it here only — open Cases to delete session data from disk." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource GmtButtonSecondary}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource GmtCard}">
            <Grid>
                <ListView x:Name="HistoryList" Style="{StaticResource GmtListView}" SelectionMode="Single"
                    ItemContainerStyle="{StaticResource GmtListViewItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource GmtTextBody}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource GmtTextBodySm}" Text="{Binding LeadSummary}" TextWrapping="Wrap" Opacity="0.85" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource GmtTextMono}" Text="{Binding ConfidenceLabel}" HorizontalAlignment="Right" />
                                    <Button Content="View on map" Click="ViewOnMap_Click" Tag="{Binding SessionId}" Style="{StaticResource GmtButtonSecondary}" />
                                    <Button Content="Open hypotheses" Click="OpenHypotheses_Click" Tag="{Binding SessionId}" Style="{StaticResource GmtButtonGhost}" />
                                    <Button Content="Remove" Click="Remove_Click" Tag="{Binding SessionId}" Style="{StaticResource GmtButtonDestructive}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <controls:EmptyState x:Name="HistoryEmpty" Icon="&#xE81C;" Title="No analysis history"
                    Description="Run a full analysis on a video — completed runs appear here automatically." />
            </Grid>
        </Border>
    </Grid>
</Page>
