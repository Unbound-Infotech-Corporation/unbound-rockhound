<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource GmtPagePaddingWide}">
        <StackPanel Spacing="{StaticResource GmtStackGapSection}" MaxWidth="640">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource GmtTextTitle}" Text="Profile" />
                <TextBlock Style="{StaticResource GmtTextBody}" TextWrapping="Wrap"
                    Text="Cloud identity shared with the Android companion. Forum is available from the nav pane." />
            </StackPanel>

            <Border x:Name="SignedOutPanel" Style="{StaticResource GmtCard}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextBody}" Text="You are not signed in." />
                    <Button Content="Sign in / create account" Click="GoSignIn_Click" Style="{StaticResource GmtButtonPrimary}" />
                </StackPanel>
            </Border>

            <Border x:Name="ProfilePanel" Style="{StaticResource GmtCard}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="48"
                            Background="{ThemeResource GmtElevation3Brush}"
                            BorderBrush="{ThemeResource GmtBrushBorderSubtle}" BorderThickness="1">
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="DisplayNameText" Style="{StaticResource GmtTextTitle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HandleText" Style="{StaticResource GmtTextCaption}" />
                            <TextBlock x:Name="EmailText" Style="{StaticResource GmtTextCaption}" Opacity="0.85" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="BIO" />
                    <TextBlock x:Name="BioText" Style="{StaticResource GmtTextBody}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="HOME REGION" />
                    <TextBlock x:Name="RegionText" Style="{StaticResource GmtTextBody}" />
                    <StackPanel x:Name="OwnerActions" Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
                        <Button Content="Edit profile" Click="Edit_Click" Style="{StaticResource GmtButtonPrimary}" />
                        <Button Content="Sign out" Click="SignOut_Click" Style="{StaticResource GmtButtonDestructive}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="ShopsPanel" Style="{StaticResource GmtCard}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="MARKETPLACE SHOPS" />
                    <TextBlock Style="{StaticResource GmtTextCaption}" TextWrapping="Wrap"
                        Text="Rockhounding / gem shops linked by this rockhound (Etsy, eBay, and more)." />
                    <StackPanel x:Name="ShopsList" Spacing="{StaticResource GmtStackGapDefault}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GmtCard}">
                <StackPanel Spacing="{StaticResource GmtStackGapDefault}">
                    <TextBlock Style="{StaticResource GmtTextLabel}" Text="LOOK UP ANOTHER PROFILE" />
                    <TextBox x:Name="LookupBox" Style="{StaticResource GmtTextBox}"
                        PlaceholderText="Handle or user UUID" />
                    <Button Content="Open profile" Click="Lookup_Click" Style="{StaticResource GmtButtonSecondary}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
