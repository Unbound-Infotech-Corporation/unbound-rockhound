<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeoMineralTrace_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource GmtTextTitle}" Text="Research Reports" />
            <TextBlock Style="{StaticResource GmtTextBody}" Text="Export and browse auditable analysis packages." />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
            <Button Content="Export last analysis" Click="Export_Click" Style="{StaticResource GmtButtonPrimary}" />
            <Button Content="Open reports folder" Click="OpenFolder_Click" Style="{StaticResource GmtButtonSecondary}" />
            <Button Content="Refresh list" Click="Refresh_Click" Style="{StaticResource GmtButtonGhost}" />
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource GmtCard}">
            <Grid>
                <ListView x:Name="ReportList" Style="{StaticResource GmtListView}" DoubleTapped="ReportList_DoubleTapped" ItemContainerStyle="{StaticResource GmtListViewItem}" />
                <controls:EmptyState x:Name="ReportEmpty" Icon="&#xE9F9;" Title="No reports yet"
                    Description="Run an analysis and export a report, or refresh to scan the reports folder." />
            </Grid>
        </Border>
    </Grid>
</Page>
