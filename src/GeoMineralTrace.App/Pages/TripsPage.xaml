<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GeoMineralTrace_App.Pages.TripsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeoMineralTrace_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource GmtPageRoot}" ColumnSpacing="{StaticResource GmtGridGap}" RowSpacing="{StaticResource GmtStackGapDefault}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Style="{StaticResource GmtTextTitle}" Text="Trips" />
            <TextBlock Style="{StaticResource GmtTextBody}" Text="Plan field days with waypoints — including locations from analyzed videos." TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{StaticResource GmtToolbarGap}">
            <Button Content="New trip…" Click="NewTrip_Click" Style="{StaticResource GmtButtonPrimary}" />
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource GmtButtonSecondary}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource GmtCard}">
            <Grid>
                <ListView x:Name="TripList" Style="{StaticResource GmtListView}" SelectionChanged="TripList_SelectionChanged"
                    ItemContainerStyle="{StaticResource GmtListViewItem}" SelectionMode="Single" />
                <controls:EmptyState x:Name="TripEmpty" Icon="&#xE707;" Title="No trips yet"
                    Description="Create a trip or add a hypothesis from the Hypotheses page." />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource GmtCard}">
            <Grid>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WaypointHeader" Style="{StaticResource GmtTextLabel}" Text="WAYPOINTS" />
                    <ListView x:Name="WaypointList" Style="{StaticResource GmtListView}" ItemContainerStyle="{StaticResource GmtListViewItem}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource GmtTextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <Border Visibility="{Binding VideoBadgeVisibility}" Style="{StaticResource GmtBadgePill}" Padding="6,2">
                                                <TextBlock Style="{StaticResource GmtTextCaption}" Text="From video" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource GmtTextCaption}" Text="{Binding Coordinates}" />
                                        <TextBlock Style="{StaticResource GmtTextBodySm}" Text="{Binding Notes}" TextWrapping="Wrap" Opacity="0.85" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Button Content="View analysis" Click="ViewAnalysis_Click" Tag="{Binding WaypointId}" Visibility="{Binding ViewAnalysisVisibility}" Style="{StaticResource GmtButtonGhost}" />
                                        <Button Content="Map" Click="WaypointMap_Click" Tag="{Binding WaypointId}" Style="{StaticResource GmtButtonGhost}" />
                                        <Button Content="Remove" Click="RemoveWaypoint_Click" Tag="{Binding WaypointId}" Style="{StaticResource GmtButtonDestructive}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <controls:EmptyState x:Name="WaypointEmpty" Icon="&#xE1C4;" Title="Select a trip"
                    Description="Choose a trip on the left to see its waypoints." />
            </Grid>
        </Border>
    </Grid>
</Page>
