<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GeoMineralTrace_App.Controls.MapActionButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="132"
    MinHeight="72">

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Border
            x:Name="ChromeBorder"
            Background="{x:Bind AccentBrush, Mode=OneWay}"
            BorderBrush="{StaticResource GmtBrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource GmtRadiusMd}"
            Padding="12,10">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="6">
                <FontIcon
                    x:Name="ActionIcon"
                    FontSize="22"
                    Foreground="White"
                    Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                <TextBlock
                    x:Name="TitleText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="11"
                    Foreground="#E6FFFFFF"
                    Text="{x:Bind Subtitle, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>
        <Border
            x:Name="HoverOverlay"
            Background="#22FFFFFF"
            CornerRadius="{StaticResource GmtRadiusMd}"
            Opacity="0" />
        <Border
            x:Name="PressOverlay"
            Background="#33000000"
            CornerRadius="{StaticResource GmtRadiusMd}"
            Opacity="0" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="{StaticResource GmtDurationFast}">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationFast}" />
                        <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource GmtDurationFast}" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource GmtDurationFast}" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource GmtDurationFast}" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource GmtDurationFast}" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="{StaticResource GmtDurationFast}" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="{StaticResource GmtDurationFast}" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource GmtDurationInstant}" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource GmtDurationInstant}" />
                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource GmtDurationInstant}" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
