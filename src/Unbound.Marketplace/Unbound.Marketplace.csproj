<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Unbound.Marketplace</RootNamespace>
    <AssemblyName>Unbound.Marketplace</AssemblyName>
    <Product>Unbound Marketplace</Product>
    <Company>Unbound Infotech Corporation</Company>
    <Description>Reusable Unbound Marketplace catalog, Stripe Checkout launcher, and license activation hook.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\fallback-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Unbound.Marketplace.Activation" />
    <Using Include="Unbound.Marketplace.Catalog" />
    <Using Include="Unbound.Marketplace.Checkout" />
  </ItemGroup>

</Project>
